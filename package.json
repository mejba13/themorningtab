{
  "name": "themorningtab",
  "description": "The Morning Tab: an AI-written front page for your new tab, built from your own browsing.",
  "homepage": "https://themorningtab.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mejba13/themorningtab.git"
  },
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "build": "pnpm --filter @themorningtab/extension build",
    "dev": "pnpm --filter @themorningtab/extension dev",
    "typecheck": "pnpm -r typecheck",
    "test": "bun test harness/",
    "agent:run": "bun harness/run-agent.ts",
    "agent:verify": "bun harness/verify-homepage.ts",
    "agent:resume-test": "bun harness/test-resume.ts crash && bun harness/test-resume.ts resume",
    "agent:retention": "bun harness/check-retention.ts",
    "extension:test": "bun harness/test-extension.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
